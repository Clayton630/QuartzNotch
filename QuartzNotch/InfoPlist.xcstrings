    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم QuartzNotch صوت النظام لتحريك الطيف المرئي بالتزامن مع التشغيل الحالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch používá systémový zvuk k animaci spektra podle aktuálního přehrávání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch verwendet Systemaudio, um das visuelle Spektrum synchron zur Wiedergabe zu animieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch uses system audio to animate the visual spectrum in sync with current playback."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch uses system audio to animate the visual spectrum in sync with current playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch usa el audio del sistema para animar el espectro visual al ritmo de la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch utilise l’audio système pour animer le spectre visuel en synchronisation avec la lecture en cours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A QuartzNotch rendszerhangot használ a vizuális spektrum aktuális lejátszással szinkronizált animálásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch usa l’audio di sistema per animare lo spettro visivo in sincronia con la riproduzione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch는 현재 재생에 맞춰 시각 스펙트럼을 애니메이션하기 위해 시스템 오디오를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch używa dźwięku systemowego do animowania widma zgodnie z bieżącym odtwarzaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O QuartzNotch usa o áudio do sistema para animar o espectro visual em sincronia com a reprodução atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch использует системный звук, чтобы анимировать визуальный спектр в такт текущему воспроизведению."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch, görsel spektrumu mevcut çalmayla eşzamanlı canlandırmak için sistem sesini kullanır."
