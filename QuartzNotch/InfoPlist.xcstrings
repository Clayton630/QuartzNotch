    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم QuartzNotch أحداث Apple للتحكم في تطبيق الموسيقى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch používá AppleEvents k ovládání hudby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch verwendet AppleEvents, um die Musikwiedergabe zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzNotch uses AppleEvents to control music playback."
          }
        },
