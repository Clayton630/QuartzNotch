          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose between your system accent colour or customize it with your own selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija entre el color de acento de su sistema o personalícelo con su propia selección."
          }
        },
        "fr" : {
          "stringUnit" : {
