    "Select the music source you want to use. You can change this later in the app settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد مصدر الموسيقى الذي تريد استخدامه. يمكنك تغيير هذا لاحقًا في إعدادات التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte zdroj hudby který chcete používat. Můžete jej později změnit v nastavení aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Musik Quelle aus, die du benutzen willst. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione la fuente de la música que desea utilizar. Puede cambiar esto más tarde en los ajustes de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la source musicale. Modifiable plus tard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki a használni kívánt zeneforrást. Ezt később módosíthatja az alkalmazás beállításaiban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selezionare la sorgente musicale che si desidera utilizzare. È possibile modificare questa impostazione in seguito nelle impostazioni dell'app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 소스 선택하세요. 나중에 앱 설정에서 변경 가능합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz źródło muzyki, którego chcesz użyć. Możesz to później zmienić w ustawieniach aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione a fonte de música que deseja usar. Você pode alterar isso posteriormente nas configurações do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите источник музыки, который вы хотите использовать. Вы можете изменить это позже в настройках приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanmak istediğiniz müzik kaynağını seçin. Bunu daha sonra uygulama ayarlarından değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть джерело музики, яке ви хочете використовувати. Ви можете змінити це пізніше в налаштуваннях програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择您想要使用的音乐源。您可以稍后在应用设置中更改此项。"
          }
        }
      }
    },
