    "Replaces the standard macOS volume, display brightness, and keyboard brightness HUDs with a custom design." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل حجم macOS القياسي وسطوع الشاشة وسطوع لوحة المفاتيح HUDs بتصميم مخصص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrazuje standardní hlasitost macOS, jas displeje a jas klávesnice HUDs vlastním designem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die Standard-macOS-Lautstärke, Display-Helligkeit und Tastaturhelligkeit HUDs durch ein benutzerdefiniertes Design."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces the standard macOS volume, display brightness, and keyboard brightness HUDs with a custom design."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces the standard macOS volume, display brightness, and keyboard brightness HUDs with a custom design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza los estándares macOS de volumen, brillo de pantalla y brillo del teclado HUD con un diseño personalizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace les HUD macOS par ceux de QuartzNotch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabványos macOS hangerőt, kijelző fényerőt és billentyűzet fényerőt HUD egyedi kialakítással váltja fel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce il volume macOS standard, la luminosità del display e la luminosità della tastiera HUD con un design personalizzato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표준 macOS 볼륨, 디스플레이 밝기 및 키보드 밝기 HUD를 맞춤형 디자인으로 대체합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje standardową głośność macOS, jasność wyświetlacza i jasność klawiatury HUD niestandardowym projektem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o volume macOS padrão, o brilho da tela e o brilho do teclado HUDs por um design personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет стандартную громкость macOS, яркость дисплея и яркость клавиатуры HUD на собственный дизайн."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standart macOS ses düzeyini, ekran parlaklığını ve klavye parlaklığını HUD'leri özel bir tasarımla değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замінює стандартну гучність macOS, яскравість дисплея та яскравість клавіатури HUDs на індивідуальний дизайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用定制设计替换标准 macOS 音量、显示屏亮度和键盘亮度 HUD。"
          }
        }
      }
    },
