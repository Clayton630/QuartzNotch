    "Configure how QuartzNotch behaves, which display it appears on, and how you interact with it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتكوين كيفية تصرف QuartzNotch، والشاشة التي تظهر عليها، وكيفية تفاعلك معها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakonfigurujte, jak se QuartzNotch chová, na jakém displeji se zobrazuje a jak s ním komunikujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
