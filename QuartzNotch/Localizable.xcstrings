    "Sneak Peek shows the media title and artist under the notch for a few seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر Sneak Peek عنوان الوسائط والفنان أسفل الشق لبضع ثوانٍ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náhled zobrazuje název skladby a autora pod výřezem na několik vteřin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek zeigt für ein paar Sekunden den Medientitel und den Künstler unter der Notch an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek shows the media title and artist under the notch for a few seconds."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek shows the media title and artist under the notch for a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistazo Rápido muestra el título y nombre del artista debajo del notch por unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek affiche brièvement le titre et l’artiste."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sneak Peek néhány másodpercig a bevágás alatt mutatja a média címét és az előadót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek mostra per alcuni secondi il titolo dei media e l'artista sotto la notch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훔쳐보기가 몇 초 동안 미디어 제목과 아티스트명을 노치 아래에 보여줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd pokazuje tytuł multimediów i artystę pod notchem przez kilka sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sneak Peek mostra o título da mídia e o artista abaixo do entalhe por alguns segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek на несколько секунд показывает название СМИ и исполнителя под меткой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön izleme, birkaç saniye boyunca çentik altında medya başlığını ve sanatçıyı gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek показує назву медіа та виконавця під виїмкою на кілька секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek 在 Notch 下显示媒体标题和艺术家几秒钟。"
          }
        }
      }
    },
