        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte, které ovládací prvky se zobrazí v hudebním přehrávači. Hlasitost se při aktivaci zvětšuje."
          }
        },
        "de" : {
          "stringUnit" : {
