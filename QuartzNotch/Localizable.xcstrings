    "Without this permission, Focus name can still be detected, but icon and tint may stay generic." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون هذا الإذن، لا يزال من الممكن اكتشاف اسم التركيز، ولكن قد يظل الرمز واللون عامان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tohoto oprávnění lze název zaměření stále detekovat, ale ikona a odstín mohou zůstat obecné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne diese Berechtigung kann der Fokusname weiterhin erkannt werden, Symbol und Farbton bleiben jedoch möglicherweise generisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without this permission, Focus name can still be detected, but icon and tint may stay generic."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without this permission, Focus name can still be detected, but icon and tint may stay generic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin este permiso, el nombre del foco aún se puede detectar, pero el ícono y el tono pueden seguir siendo genéricos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans cet accès, l’icône et la couleur Focus peuvent rester génériques."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen engedély nélkül a fókusznév továbbra is észlelhető, de az ikon és az árnyalat általános maradhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza questa autorizzazione, il nome del focus può ancora essere rilevato, ma l'icona e la tinta potrebbero rimanere generiche."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 권한이 없으면 포커스 이름은 계속 감지될 수 있지만 아이콘과 색조는 일반 상태로 유지될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego uprawnienia nadal można wykryć nazwę Fokusa, ale ikona i odcień mogą pozostać ogólne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem esta permissão, o nome do Focus ainda pode ser detectado, mas o ícone e a tonalidade podem permanecer genéricos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без этого разрешения имя фокуса все равно можно обнаружить, но значок и оттенок могут оставаться общими."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu izin olmadan Odak adı hâlâ algılanabilir ancak simge ve renk tonu genel kalabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без цього дозволу назву фокуса все одно можна виявити, але значок і відтінок можуть залишатися загальними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有此权限，仍然可以检测到焦点名称，但图标和色调可能保持通用。"
          }
        }
      }
    },
