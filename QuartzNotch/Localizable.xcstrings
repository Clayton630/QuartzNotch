    "Sneak Peek temporarily shows media details below the notch. Toggle Notch Open opens or closes QuartzNotch manually." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Sneak Peek الوسائط. يفتح الاختصار QuartzNotch أو يغلقه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek zobrazí média. Zkratka otevře nebo zavře QuartzNotch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek zeigt Medieninfos. Der Kurzbefehl öffnet oder schließt QuartzNotch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek shows media info. The shortcut opens or closes QuartzNotch."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek shows media info. The shortcut opens or closes QuartzNotch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek muestra el medio. El atajo abre o cierra QuartzNotch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek affiche le média. Le raccourci ouvre/ferme QuartzNotch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sneak Peek médiát mutat. A parancs megnyitja vagy bezárja a QuartzNotchot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek mostra i media. La scorciatoia apre o chiude QuartzNotch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek은 미디어 정보를 표시합니다. 단축키로 QuartzNotch를 열거나 닫습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek pokazuje media. Skrót otwiera lub zamyka QuartzNotch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek mostra a mídia. O atalho abre ou fecha o QuartzNotch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek показывает медиа. Сочетание открывает или закрывает QuartzNotch."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek medyayı gösterir. Kısayol QuartzNotch’u açar veya kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek показує медіа. Скорочення відкриває або закриває QuartzNotch."
          }
