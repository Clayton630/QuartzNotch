    "Choose between your system accent color or customize it with your own selection." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر بين لون تمييز النظام الخاص بك أو قم بتخصيصه من خلال اختيارك الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte si mezi barvou akcentu vašeho systému nebo si ji přizpůsobte vlastním výběrem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie zwischen der Akzentfarbe Ihres Systems oder passen Sie sie mit Ihrer eigenen Auswahl an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
